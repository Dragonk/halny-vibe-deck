{
  "name": "mistral-vibe-nexus",
  "version": "0.8.0",
  "description": "Mistral Vibe Nexus - AI Agent Desktop App",
  "main": "out/main/index.js",
  "author": "Mistral Vibe Nexus",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development nodemon --watch out/main --ext js --exec \"electron .\"",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build:win-unpacked": "npm run build && electron-builder --dir",
    "set-exe-icon": "node scripts/set-exe-icon.js",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --dir && npm run set-exe-icon && electron-builder --win nsis --prepackaged dist/win-unpacked",
    "dist:all": "npm run dist:win && npm run create-portable",
    "create-portable": "node scripts/create-portable.js",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron ."
  },
  "build": {
    "appId": "com.mistral.vibe-nexus",
    "productName": "Mistral Vibe Nexus",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/ws/**",
      "node_modules/selfsigned/**",
      "node_modules/node-forge/**"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Development"
    }
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@electron-toolkit/preload": "^3.0.1",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "^6.4.299",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "selfsigned": "^5.5.0",
    "simple-git": "^4.0.2",
    "smol-toml": "^1.9.1",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "archiver": "^7.0.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.9",
    "rcedit": "^5.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wait-on": "^8.0.3",
    "zustand": "^5.0.16"
  }
}
